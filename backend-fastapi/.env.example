# Generated with Claude (Anthropic, 2026).
# Copy to .env and fill in. Never commit .env.
JWT_SECRET=paste-output-of: python -c "import secrets; print(secrets.token_hex(32))"

# Local default is SQLite. In the cloud, PostgreSQL:
# DATABASE_URL=postgresql+psycopg://smartbed:PASSWORD@db:5432/smartbed
DATABASE_URL=sqlite:///./smartbed.db

# MQTT broker. Leave MQTT_HOST empty to run the API without MQTT.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
SIM_INTERVAL_SECONDS=10
