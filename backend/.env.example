# Default local development uses SQLite. For PostgreSQL replace with:
# DATABASE_URL=postgresql+psycopg://smartbed:smartbed@localhost:5432/smartbed
DATABASE_URL=sqlite:///smartbed.db
API_KEY=change-this-long-random-secret
# Comma-separated allowed frontend origins (avoid * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to Europe/Dublin or the timezone used by the bed user.
BED_TIMEZONE=Europe/Dublin
